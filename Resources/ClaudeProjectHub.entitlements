<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required because we run with Hardened Runtime enabled. Without this
         entitlement, macOS silently denies all Apple Events from the hub
         (no consent prompt is even shown). NSAppleEventsUsageDescription in
         Info.plist still controls the prompt text the user sees the first
         time we try to control a specific app. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
